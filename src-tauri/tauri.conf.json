{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbe",
  "version": "0.2.0",
  "identifier": "app.orbe.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbe",
        "width": 1360,
        "height": 860,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b070e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Santiago Petean",
    "copyright": "© 2026 Santiago Petean",
    "homepage": "https://www.santiago-petean.com/",
    "shortDescription": "A beautiful Git client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
